+  public int recommendedContext(){
+    long gib=totalMemoryBytes()/(1024L*1024L*1024L);
+    if(gib>0&&gib<=4)return 1536;
+    if(gib<=6&&gib>0)return 2048;
+    if(gib<=8&&gib>0)return 3072;
+    return 4096;
+  }
+
+  public int recommendedThreads(){
+    int cores=Math.max(1,Runtime.getRuntime().availableProcessors());
+    if(cores<=4)return Math.max(2,cores-1);
+    return Math.min(4,Math.max(2,cores/2));
+  }
+
+  public String memoryProfile(){
